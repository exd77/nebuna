# NextAuth.js
# Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=

# App URL for local/self-hosted env
AUTH_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database — libSQL / SQLite-compatible
DATABASE_URL=file:./data/auth.db
DATABASE_AUTH_TOKEN=

# OAuth providers (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXT_PUBLIC_AUTH_GOOGLE_ENABLED=false
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
NEXT_PUBLIC_AUTH_DISCORD_ENABLED=false
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
NEXT_PUBLIC_AUTH_GITHUB_ENABLED=false

# Password reset email via Resend (optional)
RESEND_API_KEY=
PASSWORD_RESET_FROM="Nebuna Store <noreply@example.com>"

# Tripay QRIS (optional; if empty the app falls back to mock QR mode)
TRIPAY_BASE_URL=https://tripay.co.id/api-sandbox
TRIPAY_MERCHANT_CODE=
TRIPAY_API_KEY=
TRIPAY_PRIVATE_KEY=
TRIPAY_PUBLIC_BASE_URL=
TRIPAY_CALLBACK_URL=
