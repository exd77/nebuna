# NextAuth.js
# Generate with: npx auth secret  (or: openssl rand -base64 32)
AUTH_SECRET=

# Auth.js infers automatically on Vercel; only set in self-hosted/dev
# AUTH_URL=http://localhost:3000

# Database — libSQL (SQLite-compatible)
# Local dev:    file:./data/auth.db
# Production:   libsql://<name>-<org>.turso.io   (set DATABASE_AUTH_TOKEN as well)
DATABASE_URL=file:./data/auth.db
DATABASE_AUTH_TOKEN=***

# OAuth providers (optional)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_DISCORD_ID=
AUTH_DISCORD_SECRET=
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=

# Password reset email via Resend (optional)
RESEND_API_KEY=
PASSWORD_RESET_FROM="Nebuna Store <noreply@example.com>"
